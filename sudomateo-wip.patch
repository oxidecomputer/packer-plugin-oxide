--- /dev/null
+++ b/.agents/setup
@@ -0,0 +1,37 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+readonly NIX_PROFILE="${HOME}/.nix-profile/etc/profile.d/nix.sh"
+
+echo "==> Installing Nix"
+"$(dirname "${BASH_SOURCE[0]}")/install-nix"
+
+# shellcheck disable=SC1090
+source "${NIX_PROFILE}"
+
+repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+profile_marker="# packer-plugin-oxide Nix development shell"
+hook="${HOME}/.config/packer-plugin-oxide/nix-env.sh"
+mkdir -p "$(dirname "${hook}")"
+cat > "${hook}" <<EOF
+if [[ -z "\${PACKER_PLUGIN_OXIDE_NIX_ACTIVE:-}" && "\${PWD}" == "${repo_root}" ]]; then
+  eval "\$("${HOME}/.nix-profile/bin/nix" print-dev-env "path:${repo_root}")"
+fi
+EOF
+
+if ! grep -Fqx "${profile_marker}" "${HOME}/.bash_profile" 2>/dev/null; then
+  cat >> "${HOME}/.bash_profile" <<EOF
+
+${profile_marker}
+source "${hook}"
+EOF
+fi
+
+echo "==> Building the pinned Nix development environment"
+nix develop "path:${repo_root}" --command true
+
+echo "==> Downloading Go modules"
+nix develop "path:${repo_root}" --command go mod download
+nix develop "path:${repo_root}" --command go mod download -modfile=tools/go.mod
+
+echo "==> Orb setup complete"
