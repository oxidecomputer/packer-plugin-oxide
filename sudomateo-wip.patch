+func buildPluginVersion() *version.PluginVersion {
+	info, ok := debug.ReadBuildInfo()
+	return pluginVersionFromBuildInfo(info, ok)
+}
+
+func pluginVersionFromBuildInfo(info *debug.BuildInfo, ok bool) *version.PluginVersion {
+	if !ok {
+		return version.NewPluginVersion("", "dev", "")
+	}
+
+	revision, modified := vcsSettings(info.Settings)
+	if revision != "" {
+		version.GitCommit = revision
+	}
+
+	if raw := strings.TrimPrefix(info.Main.Version, "v"); raw != "" && raw != "(devel)" {
+		pluginVersion := version.NewRawVersion(raw)
+		if prerelease := pluginVersion.GetVersionPrerelease(); prerelease != "" &&
+			prerelease != "dev" {
+			metadata := prerelease
+			if buildMetadata := pluginVersion.GetMetadata(); buildMetadata != "" {
+				metadata += "." + buildMetadata
+			}
+			return version.NewPluginVersion(pluginVersion.GetVersion(), "dev", metadata)
+		}
+		return pluginVersion
+	}
+
+	metadata := ""
+	if revision != "" {
+		if len(revision) > 12 {
+			revision = revision[:12]
+		}
+		metadata = revision
+		if modified {
+			metadata += ".dirty"
+		}
+	}
+	return version.NewPluginVersion("", "dev", metadata)
+}
+
+func vcsSettings(settings []debug.BuildSetting) (revision string, modified bool) {
+	for _, setting := range settings {
+		switch setting.Key {
+		case "vcs.revision":
+			revision = setting.Value
+		case "vcs.modified":
+			modified = setting.Value == "true"
+		}
+	}
+	return revision, modified
+}
 
