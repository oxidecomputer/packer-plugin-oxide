new file mode 100755
index 0000000..7cbdef6
--- /dev/null
+++ b/.agents/install-nix
@@ -0,0 +1,25 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+readonly NIX_VERSION="2.35.1"
+readonly NIX_INSTALLER_SHA256="34e0ef63ec1f3e552e15069660afd9a0a23f69009e340c33067595252888286c"
+
+if [[ ! -x "${HOME}/.nix-profile/bin/nix" ]]; then
+  sudo install -d -m 0755 -o "$(id -u)" -g "$(id -g)" /nix
+  tmp="$(mktemp)"
+  trap 'rm -f "${tmp}"' EXIT
+  curl --fail --location --silent --show-error \
+    "https://releases.nixos.org/nix/nix-${NIX_VERSION}/install" \
+    --output "${tmp}"
+  echo "${NIX_INSTALLER_SHA256}  ${tmp}" | sha256sum --check --status
+  sh "${tmp}" --no-daemon --yes --no-channel-add
+fi
+
+mkdir -p "${HOME}/.config/nix"
+if ! grep -Fqx "experimental-features = nix-command flakes" "${HOME}/.config/nix/nix.conf" 2>/dev/null; then
+  echo "experimental-features = nix-command flakes" >> "${HOME}/.config/nix/nix.conf"
+fi
+
+if [[ -n "${GITHUB_PATH:-}" ]]; then
+  echo "${HOME}/.nix-profile/bin" >> "${GITHUB_PATH}"
+fi
