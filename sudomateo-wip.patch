diff --git a/main_test.go b/main_test.go
new file mode 100644
index 0000000..20dac6e
--- /dev/null
+++ b/main_test.go
@@ -0,0 +1,73 @@
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at https://mozilla.org/MPL/2.0/.
+
+package main
+
+import (
+	"runtime/debug"
+	"testing"
+)
+
+func TestPluginVersionFromBuildInfo(t *testing.T) {
+	tests := []struct {
+		name string
+		info *debug.BuildInfo
+		ok   bool
+		want string
+	}{
+		{
+			name: "tagged release",
+			info: &debug.BuildInfo{Main: debug.Module{Version: "v1.2.3"}},
+			ok:   true,
+			want: "1.2.3",
+		},
+		{
+			name: "pseudo-version",
+			info: &debug.BuildInfo{
+				Main: debug.Module{Version: "v1.2.4-0.20260818230903-0123456789ab+dirty"},
+			},
+			ok:   true,
+			want: "1.2.4-dev+0.20260818230903-0123456789ab.dirty",
+		},
+		{
+			name: "legacy devel fallback",
+			info: &debug.BuildInfo{
+				Main: debug.Module{Version: "(devel)"},
+				Settings: []debug.BuildSetting{
+					{Key: "vcs.revision", Value: "0123456789abcdef"},
+					{Key: "vcs.modified", Value: "true"},
+				},
+			},
+			ok:   true,
+			want: "0.0.0-dev+0123456789ab.dirty",
+		},
+		{
+			name: "missing build information",
+			ok:   false,
+			want: "0.0.0-dev",
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := pluginVersionFromBuildInfo(tt.info, tt.ok).String(); got != tt.want {
+				t.Fatalf("plugin version = %q, want %q", got, tt.want)
+			}
+		})
+	}
+}
+
+func TestVCSSettings(t *testing.T) {
+	revision, modified := vcsSettings([]debug.BuildSetting{
+		{Key: "vcs", Value: "git"},
+		{Key: "vcs.revision", Value: "0123456789abcdef"},
+		{Key: "vcs.modified", Value: "true"},
+	})
+	if revision != "0123456789abcdef" {
+		t.Fatalf("revision = %q, want 0123456789abcdef", revision)
+	}
+	if !modified {
+		t.Fatal("modified = false, want true")
+	}
+}
